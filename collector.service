[Unit]
Description=Tailscale and Headscale status & control daemon for Komari
Wants=tailscaled.service headscale.service
After=tailscaled.service headscale.service

[Service]
Type=simple
ExecStart=/usr/bin/python3 /usr/local/libexec/komari-tailscale-collector.py --daemon
Restart=always
RestartSec=2
UMask=0077
PrivateTmp=true

[Install]
WantedBy=multi-user.target
